{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LogiTracker": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "Outbox": {
    "DispatcherEnabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 5,
    "BaseRetryDelay": "00:00:02",
    "MaxRetryDelay": "00:05:00",
    "Lease": "00:00:30"
  },
  "FaultInjection": {
    "Enabled": false
  },
  "Observability": {
    "ConsoleExporter": false
  },
  "RateLimiting": {
    "PermitsPerMinute": 300
  }
}
